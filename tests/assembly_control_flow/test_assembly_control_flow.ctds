program {
    integer get_int() extern;
    void print_int(integer i) extern;

    integer factorial(integer n) {
        if (n == 0) then {
            return 1;
        } else {
            return n * factorial(n - 1);
        }
    }

    integer sum_to(integer n) {
        integer s = 0;
        while (n > 0) {
            s = s + n;
            n = n - 1;
        }
        return s;
    }

    bool test_bool(bool a, bool b) {
        if (a && b) then {
            return true;
        } else {
            return a || b;
        }
    }

    void main() {
        integer sel = 0;
        sel = get_int();

        if (sel == 1) then {
            // test if/else y comparación
            integer x = 3;
            if (x < 5) then {
                print_int(1);
            } else {
                print_int(0);
            }
        } else {
            if (sel == 2) then {
                // test while y asignación
                integer i = 3;
                integer acc = 0;
                while (i > 0) {
                    acc = acc + i;
                    i = i - 1;
                }
                print_int(acc);  // Esperado: 6
            } else {
                if (sel == 3) then {
                    // test llamada a función y return
                    print_int(factorial(4)); // Esperado: 24
                } else {
                    if (sel == 4) then {
                        // test funciones booleanas y operadores lógicos
                        bool r = test_bool(true, false);
                        if (r) then {
                            print_int(1);
                        } else {
                            print_int(0);
                        }
                    } else {
                        if (sel == 5) then {
                            // test anidamiento
                            integer y = 2;
                            if (y == 2) then {
                                if (y + 1 == 3) then {
                                    print_int(9);
                                } else {
                                    print_int(8);
                                }
                            } else {
                                print_int(7);
                            }
                        } else {
                            if (sel == 6) then {
                                // test retorno simple de suma
                                print_int(sum_to(4)); // Esperado: 10
                            } else {
                                // test default
                                print_int(0);
                            }
                        }
                    }
                }
            }
        }
    }
}
