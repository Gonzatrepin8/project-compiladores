/*
 * Un programa completo que calcula el factorial de un número.
 * Adaptado a la sintaxis de TDS25.
 */
program {
    integer factorial(integer n) {
        if (n == 0) then {
            return 1;
        } else {
            return n * factorial(n - 1);
        }
    }

    void main() {
        integer num = 3;
        integer result = 10; 
        num = 1 + 1 + 1 + 1 + 1 + 1 + 1 + 2 * 2;
        result = factorial(num);
        if(true) then {
            result = 4 + 4 + 4+ 4+ 4+ 4+ 4+ 4+ 4;
            return;
            result = 4 + 4 + 4+ 4+ 4+ 4+ 4+ 4+ 4;
        }
        return;
        result = 1;
        result = 2;
        result = 3;
        result = 4;
        return;
    }
}